NODE_ENV=$NODE_ENV
NEXTAUTH_SECRET=$NEXTAUTH_SECRET
NEXTAUTH_URL=$NEXTAUTH_URL
NEXT_PUBLIC_NOTIFICATION_URL=$NEXT_PUBLIC_NOTIFICATION_URL
NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

# Google OAuth — Public config (safe to expose to client bundle)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=$NEXT_PUBLIC_GOOGLE_CLIENT_ID
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=$NEXT_PUBLIC_GOOGLE_REDIRECT_URI

# Google OAuth — Server-only secrets (KHÔNG dùng NEXT_PUBLIC_ prefix)
# Các biến này chỉ được đọc ở server-side API Routes, không lộ ra client bundle.
GOOGLE_CLIENT_ID=$GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=$GOOGLE_CLIENT_SECRET
